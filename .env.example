# ---------------------------------------------------------------------------
# Roster — environment variables
# Copy this file to `.env` and fill in real values for local development.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Postgres connection string. Local example shown.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roster?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional; required if you enable Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic-link (optional; SMTP server URL like smtp://user:pass@host:587)
EMAIL_SERVER=""
EMAIL_FROM="Roster <no-reply@example.com>"

# --- Observability ----------------------------------------------------------
# Server-side Sentry DSN
SENTRY_DSN=""
# Client-side Sentry DSN (must be NEXT_PUBLIC_*)
NEXT_PUBLIC_SENTRY_DSN=""

# PostHog (client + server share the same project key in v1)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Storage (Phase 4+) -----------------------------------------------------
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Background jobs (Phase 2+) --------------------------------------------
REDIS_URL=""

# --- Web Push (Phase 2+) ----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- App --------------------------------------------------------------------
NODE_ENV="development"
