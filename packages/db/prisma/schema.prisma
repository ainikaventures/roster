// ---------------------------------------------------------------------------
// Roster — Phase 0 data model
//
// Three-level org hierarchy:
//   Organization → Branch → Team → Employee
//
// Employees are scoped to exactly one team.
// Managers can span multiple teams and/or branches via ManagerAssignment.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Tenancy
// =====================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  locale    String   @default("en")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  memberships     Membership[]
  shifts          Shift[]
  timeEntries     TimeEntry[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  channels        Channel[]
  announcements   Announcement[]
  tasks           Task[]
  formTemplates   FormTemplate[]
  formSubmissions FormSubmission[]
}

model Branch {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams              Team[]
  managerAssignments ManagerAssignment[]
  channels           Channel[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Team {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  color     String? // hex, used in multi-team calendar color-coding
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  members            Membership[]
  shifts             Shift[]
  timeEntries        TimeEntry[]
  managerAssignments ManagerAssignment[]
  channels           Channel[]
  tasks              Task[]
  formTemplates      FormTemplate[]
  formSubmissions    FormSubmission[]

  @@unique([branchId, name])
  @@index([branchId])
}

// =====================================================================
// Users & access
// =====================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  avatarUrl     String?
  timezone      String? // null = inherit from org
  locale        String? // null = inherit from org
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships         Membership[]
  managerAssignments  ManagerAssignment[]
  accounts            Account[]
  sessions            Session[]
  shifts              Shift[]
  timeEntries         TimeEntry[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  channelMembers      ChannelMember[]
  messages            Message[]
  reactions           MessageReaction[]
  createdChannels     Channel[]             @relation("ChannelCreator")
  announcements       Announcement[]
  announcementReads   AnnouncementRead[]
  createdTasks        Task[]                @relation("TaskCreator")
  assignedTasks       Task[]                @relation("TaskAssignee")
  taskCompletions     TaskCompletion[]
  createdFormTemplates FormTemplate[]
  formSubmissions     FormSubmission[]
}

// Auth.js (NextAuth) — OAuth account link
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js session row
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auth.js verification token (magic links)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One user can belong to multiple orgs (workspace switcher).
// Membership locks a user to a role within an org.
//
// - EMPLOYEE: teamId MUST be set (exactly one team).
// - ADMIN / OWNER: teamId is NULL (org-wide).
// - BRANCH_MANAGER / TEAM_MANAGER: teamId is NULL on Membership;
//   actual scope comes from ManagerAssignment rows.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  teamId    String?
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId, role])
  @@index([teamId])
}

// Managers can span multiple branches and/or teams.
// Exactly one of (branchId, teamId) should be set per row.
// Employees do NOT use this table — their team comes from Membership.teamId.
model ManagerAssignment {
  id        String   @id @default(cuid())
  userId    String
  branchId  String?
  teamId    String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId, teamId])
  @@index([userId])
  @@index([branchId])
  @@index([teamId])
}

enum Role {
  OWNER
  ADMIN
  BRANCH_MANAGER
  TEAM_MANAGER
  EMPLOYEE
}

// =====================================================================
// Scheduling
// =====================================================================

model Shift {
  id        String   @id @default(cuid())
  orgId     String
  teamId    String
  userId    String?
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([teamId, startsAt])
  @@index([userId, startsAt])
}

// =====================================================================
// Time clock
// =====================================================================

model TimeEntry {
  id         String    @id @default(cuid())
  orgId      String
  teamId     String
  userId     String
  clockedIn  DateTime
  clockedOut DateTime?
  approved   Boolean   @default(false)
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team   Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks Break[]

  @@index([orgId])
  @@index([teamId, userId, clockedIn])
  @@index([userId, clockedIn])
}

model Break {
  id          String    @id @default(cuid())
  timeEntryId String
  startedAt   DateTime
  endedAt     DateTime?
  paid        Boolean   @default(false)

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId])
}

// =====================================================================
// Audit log
// =====================================================================

// =====================================================================
// Notifications (Phase 1 — in-app only; email/push arrive in later phases)
// =====================================================================

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  kind      String // see NotificationKind in @roster/types
  title     String
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([orgId])
}

// =====================================================================
// Audit log
// =====================================================================

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String // e.g. "shift.created", "membership.role_changed"
  entity    String // e.g. "Shift", "Membership"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

// =====================================================================
// Chat (Phase 2)
//
// A Channel is scoped by exactly one of (teamId | branchId | orgId).
// kind=TEAM/BRANCH/ORG are "broadcast" channels — anyone with scope
// access auto-joins. kind=DM/GROUP are explicit — only listed members
// see them.
//
// `lastReadAt` on ChannelMember drives unread counts. Polling is the
// transport for Phase 2; Socket.IO/SSE is a swap behind the same API.
// =====================================================================

enum ChannelKind {
  TEAM
  BRANCH
  ORG
  GROUP
  DM
}

model Channel {
  id          String      @id @default(cuid())
  orgId       String
  kind        ChannelKind
  teamId      String?
  branchId    String?
  name        String?
  description String?
  isPrivate   Boolean     @default(false)
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team      Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  messages  Message[]

  @@unique([orgId, kind, teamId])
  @@unique([orgId, kind, branchId])
  @@index([orgId])
  @@index([teamId])
  @@index([branchId])
}

model ChannelMember {
  id          String    @id @default(cuid())
  channelId   String
  userId      String
  joinedAt    DateTime  @default(now())
  lastReadAt  DateTime?
  mutedUntil  DateTime?
  notifyLevel String    @default("all") // "all" | "mentions" | "none"

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  userId    String
  body      String    @db.Text
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([channelId, createdAt])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String // e.g. ":thumbsup:" or unicode
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// =====================================================================
// Announcements (Phase 2)
//
// A one-way broadcast targeted at an org, branch, or team. Read receipts
// are tracked per user via AnnouncementRead.
// =====================================================================

enum AnnouncementScope {
  ORG
  BRANCH
  TEAM
}

model Announcement {
  id          String            @id @default(cuid())
  orgId       String
  createdById String
  scope       AnnouncementScope
  scopeId     String? // branchId or teamId; null when scope=ORG
  title       String
  body        String            @db.Text
  publishedAt DateTime          @default(now())
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reads     AnnouncementRead[]

  @@index([orgId, publishedAt])
  @@index([scope, scopeId])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// =====================================================================
// Tasks (Phase 3)
//
// A task belongs to exactly one team. Optional assignee (open tasks have
// userId=null). Recurring tasks are modeled by `recurrence` — when set,
// every completion creates a TaskCompletion row, and the task stays
// open. One-off tasks transition to status=DONE on completion.
// =====================================================================

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id                       String         @id @default(cuid())
  orgId                    String
  teamId                   String
  assignedUserId           String?
  createdById              String
  title                    String
  description              String?        @db.Text
  status                   TaskStatus     @default(OPEN)
  priority                 TaskPriority   @default(NORMAL)
  dueAt                    DateTime?
  recurrence               TaskRecurrence @default(NONE)
  /// Whether the completer must attach a photo. (Attachment upload arrives in Phase 4.)
  requirePhoto             Boolean        @default(false)
  /// Whether the completer must attach a signature.
  requireSignature         Boolean        @default(false)
  /// Whether the completer must add a free-text note.
  requireNote              Boolean        @default(false)
  archivedAt               DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  completions TaskCompletion[]

  @@index([orgId])
  @@index([teamId, status])
  @@index([assignedUserId, status])
}

model TaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  completedAt DateTime @default(now())
  notes       String?  @db.Text
  /// JSON-encoded list of attachment URLs (filled in Phase 4 when S3 lands).
  evidence    Json?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, completedAt])
  @@index([userId])
}

// =====================================================================
// Forms (Phase 3)
//
// A FormTemplate stores the field schema as JSON. The runtime layer
// (apps/web/lib/forms.ts) defines the supported field types and
// conditional logic. Submissions store the answers as JSON, keyed by
// field id.
// =====================================================================

model FormTemplate {
  id          String  @id @default(cuid())
  orgId       String
  /// Optional team scope. NULL = available to everyone in the org.
  teamId      String?
  title       String
  description String?
  /// Wire format: { fields: FieldDef[], scoring?: ScoringConfig, settings?: ... }
  schema      Json
  isActive    Boolean @default(true)
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([orgId])
  @@index([teamId])
}

enum FormSubmissionStatus {
  SUBMITTED
  REVIEWED
  FLAGGED
}

model FormSubmission {
  id          String               @id @default(cuid())
  orgId       String
  formId      String
  userId      String
  teamId      String?
  /// Answers keyed by field id. Shape determined by the form's schema.
  answers     Json
  /// Aggregate score (computed at submit time if the schema declares scoring).
  score       Int?
  maxScore    Int?
  status      FormSubmissionStatus @default(SUBMITTED)
  reviewerId  String?
  reviewedAt  DateTime?
  reviewNotes String?              @db.Text
  submittedAt DateTime             @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  form     FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([orgId, submittedAt])
  @@index([formId])
  @@index([userId])
  @@index([teamId])
}
